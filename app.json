{
  "expo": {
    "name": "Meu Treino",
    "slug": "meu-treino",
    "scheme": "meu-treino",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-sqlite",
      "expo-localization",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#28133F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#28133F",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.picolitios.meutreino",
      "infoPlist": {}
    },
    "android": {
      "package": "com.picolitios.meutreino",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#28133F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "767c23a7-fa56-41f6-9fa6-8a6e0eb30d40"
      }
    },
    "owner": "picolitios"
  }
}
